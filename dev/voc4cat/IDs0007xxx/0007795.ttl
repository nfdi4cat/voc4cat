    skos:altLabel "coprecipitation"@en ;
    skos:broader voc4cat:0007027 ;
    skos:changeNote "0000-0003-4418-7455 Franziska Flecken created the resource"@en ;
    skos:definition "A specific step in the synthesis of a solid materal which is characterised by the simultaneous precipitation of two or more precursor species from a homogeneous solution. The precipitation is typically driven by the addition of a precipitation agent that changes the solubility of the precursors."@en ;
